      <column caption='Age Group (10 Years)' datatype='string' name='[Calculation_182466198629589002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_182466198628712456] &lt; 10 THEN &apos;&lt;10&apos;&#10;ELSEIF [Calculation_182466198628712456] &lt; 20 THEN &apos;10-19&apos;&#10;ELSEIF [Calculation_182466198628712456] &lt; 30 THEN &apos;20-29&apos;&#10;ELSEIF [Calculation_182466198628712456] &lt; 40 THEN &apos;30-39&apos;&#10;ELSEIF [Calculation_182466198628712456] &lt; 50 THEN &apos;40-49&apos;&#10;ELSEIF [Calculation_182466198628712456] &lt; 60 THEN &apos;50-59&apos;&#10;ELSEIF [Calculation_182466198628712456] &lt; 70 THEN &apos;60-69&apos;&#10;ELSEIF [Calculation_182466198628712456] &lt; 80 THEN &apos;70-79&apos;&#10;ELSE &apos;80+&apos;&#10;END' />
      </column>
