      <column caption='Age' datatype='integer' name='[Calculation_182466198628712456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(DATEDIFF(&apos;year&apos;, [DOB], {MAX([Date of Hire])}))' />
