    <worksheet name='Marital Leaving'>
      <table>
        <view>
          <datasources>
            <datasource caption='staff_particulars+ Data Source' name='federated.042lc85189vi03151yihi1jhhcfp' />
          </datasources>
          <datasource-dependencies datasource='federated.042lc85189vi03151yihi1jhhcfp'>
            <column caption='Tenure Days' datatype='integer' name='[Calculation_182466198293688321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Date of Hire], [Date of Termination])' />
            </column>
            <column caption='Grouping of Tenure (6months)' datatype='string' name='[Calculation_182466198296231939]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_182466198293688321] &lt;= 180 THEN &apos;0-6 months&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 360 THEN &apos;6-12 months&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 540 THEN &apos;1-1.5 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 720 THEN &apos;1.5-2 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 900 THEN &apos;2-2.5 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 1080 THEN &apos;2.5-3 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 1260 THEN &apos;3-3.5 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 1440 THEN &apos;3.5-4 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 1620 THEN &apos;4-4.5 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 1800 THEN &apos;4.5-5 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 1980 THEN &apos;5-5.5 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 2160 THEN &apos;5.5-6 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 2340 THEN &apos;6-6.5 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 2520 THEN &apos;6.5-7 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 2700 THEN &apos;7-7.5 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 2880 THEN &apos;7.5-8 years&apos;&#10;ELSE &apos;Over 8 years&apos;&#10;END' />
            </column>
            <column datatype='date' name='[Date of Hire]' role='dimension' type='ordinal' />
            <column datatype='date' name='[Date of Termination]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
