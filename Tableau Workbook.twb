    <worksheet name='Reasons for Term (Dashboard)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Verdana'>Termination Reasons</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='staff_particulars+ Data Source' name='federated.042lc85189vi03151yihi1jhhcfp' />
          </datasources>
          <datasource-dependencies datasource='federated.042lc85189vi03151yihi1jhhcfp'>
            <column caption='Tenure Days' datatype='integer' name='[Calculation_182466198293688321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Date of Hire], [Date of Termination])' />
            </column>
            <column caption='Grouping of Tenure (years)' datatype='string' name='[Calculation_182466198298324996]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_182466198293688321] &lt;= 365 THEN &apos;0-1 year&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 730 THEN &apos;1-2 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 1095 THEN &apos;2-3 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 1460 THEN &apos;3-4 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 1825 THEN &apos;4-5 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 2190 THEN &apos;5-6 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 2555 THEN &apos;6-7 years&apos;&#10;ELSEIF [Calculation_182466198293688321] &lt;= 2920 THEN &apos;7-8 years&apos;&#10;ELSE &apos;Over 8 years&apos;&#10;END' />
            </column>
            <column caption='Active Tenure Days' datatype='integer' name='[Calculation_182466198352756742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Date of Hire], {MAX([Date of Hire])})' />
            </column>
            <column caption='Active Tenure Years' datatype='string' name='[Calculation_182466198353809415]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_182466198352756742] &lt;= 365 THEN &apos;0-1 year&apos;&#10;ELSEIF [Calculation_182466198352756742] &lt;= 730 THEN &apos;1-2 years&apos;&#10;ELSEIF [Calculation_182466198352756742] &lt;= 1095 THEN &apos;2-3 years&apos;&#10;ELSEIF [Calculation_182466198352756742] &lt;= 1460 THEN &apos;3-4 years&apos;&#10;ELSEIF [Calculation_182466198352756742] &lt;= 1825 THEN &apos;4-5 years&apos;&#10;ELSEIF [Calculation_182466198352756742] &lt;= 2190 THEN &apos;5-6 years&apos;&#10;ELSEIF [Calculation_182466198352756742] &lt;= 2555 THEN &apos;6-7 years&apos;&#10;ELSEIF [Calculation_182466198352756742] &lt;= 2920 THEN &apos;7-8 years&apos;&#10;ELSEIF [Calculation_182466198352756742] &lt;= 3285 THEN &apos;8-9 years&apos;&#10;ELSEIF [Calculation_182466198352756742] &lt;= 3650 THEN &apos;9-10 years&apos;&#10;ELSEIF [Calculation_182466198352756742] &lt;= 4015 THEN &apos;10-11 years&apos;&#10;ELSEIF [Calculation_182466198352756742] &lt;= 4380 THEN &apos;11-12 years&apos;&#10;ELSE &apos;Over 12 years&apos;&#10;END' />
            </column>
